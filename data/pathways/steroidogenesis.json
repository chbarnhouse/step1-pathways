 "enzymes": {
  "star": {
   "name": "StAR protein",
   "short": "StAR",
   "aliases": [
    "steroidogenic acute regulatory protein"
   ],
   "notes": "Moves cholesterol from the outer to the inner mitochondrial membrane — the acute, rate-limiting event. Mutations → congenital lipoid adrenal hyperplasia."
  },
  "scc": {
   "name": "Desmolase",
   "short": "CYP11A1",
   "aliases": [
    "cholesterol desmolase",
    "cholesterol side-chain cleavage enzyme",
    "side-chain cleavage enzyme",
    "P450scc"
   ],
   "notes": "Rate-limiting enzyme. Stimulated by ACTH (adrenal) and LH (gonads). Inhibited by ketoconazole (also blocks 17,20-lyase)."
  },
  "hsd3b": {
   "name": "3β-Hydroxysteroid dehydrogenase",
   "short": "3β-HSD",
   "aliases": [
    "3-beta-hydroxysteroid dehydrogenase"
   ],
   "nicknames": [
    "3 beta HSD"
   ],
   "notes": "Acts at three spots (pregnenolone, 17-OH-pregnenolone, DHEA). Deficiency: ↓ all three classes, salt wasting; ambiguous genitalia in both sexes."
  },
  "cyp17h": {
   "name": "17α-Hydroxylase",
   "short": "CYP17A1",
   "aliases": [
    "17-alpha-hydroxylase",
    "17 alpha hydroxylase",
    "17-hydroxylase"
   ],
   "nicknames": [
    "CYP17"
   ],
   "notes": "Deficiency: ↓ cortisol and sex hormones, ↑ DOC → hypertension, hypokalemia; XY undervirilized (female-appearing), XX lacks secondary sexual development. Abiraterone inhibits CYP17."
  },
  "cyp17l": {
   "name": "17,20-Lyase",
   "short": "CYP17A1",
   "aliases": [
    "17,20 lyase",
    "17,20-desmolase",
    "17 20 lyase"
   ],
   "notes": "Same CYP17A1 protein as 17α-hydroxylase. Inhibited by ketoconazole and abiraterone."
  },
  "cyp21": {
   "name": "21-Hydroxylase",
   "short": "CYP21A2",
   "aliases": [
    "21-hydroxylase",
    "21 hydroxylase",
    "21-alpha-hydroxylase"
   ],
   "nicknames": [
    "CYP21"
   ],
   "notes": "Most common CAH (>90%): ↓ cortisol and aldosterone, ↑ 17-OH-progesterone and androgens → salt wasting, hypotension, hyperkalemia, ↑ renin; virilized XX, precocious puberty in XY."
  },
  "cyp11b1": {
   "name": "11β-Hydroxylase",
   "short": "CYP11B1",
   "aliases": [
    "11-beta-hydroxylase",
    "11 beta hydroxylase"
   ],
   "notes": "Deficiency: ↓ cortisol and aldosterone but ↑ 11-deoxycorticosterone → hypertension and hypokalemia (↓ renin), plus virilization."
  },
  "cyp11b2": {
   "name": "Aldosterone synthase",
   "short": "CYP11B2",
   "aliases": [
    "aldosterone synthetase",
    "18-hydroxylase"
   ],
   "notes": "Zona glomerulosa only; activated by angiotensin II and hyperkalemia."
  },
  "hsd17b": {
   "name": "17β-Hydroxysteroid dehydrogenase",
   "short": "17β-HSD",
   "aliases": [
    "17-beta-hydroxysteroid dehydrogenase"
   ],
   "nicknames": [
    "17 beta HSD"
   ],
   "notes": "Testes (Leydig cells) and ovary. Deficiency → undervirilized XY."
  },
  "arom": {
   "name": "Aromatase",
   "short": "CYP19A1",
   "aliases": [
    "estrogen synthase",
    "aromatase"
   ],
   "nicknames": [
    "CYP19"
   ],
   "notes": "Granulosa cells, adipose, placenta. Inhibitors (anastrozole, letrozole) treat ER+ breast cancer. Deficiency → maternal virilization in pregnancy."
  },
  "srd5a": {
   "name": "5α-Reductase",
   "short": "SRD5A2",
   "aliases": [
    "5-alpha-reductase",
    "5 alpha reductase",
    "5α reductase"
   ],
   "notes": "Peripheral tissues (prostate, skin, hair follicles). Finasteride inhibits it (BPH, male-pattern baldness). Deficiency → ambiguous genitalia at birth, virilizing at puberty."
  }
 },
