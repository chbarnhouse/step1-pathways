   "name": "Glucose-6-phosphatase",
   "short": "G6Pase",
   "aliases": [
    "glucose 6-phosphatase"
   ],
   "notes": "In the ER lumen of liver and kidney (not muscle). Deficiency = von Gierke disease (type I glycogen storage): severe fasting hypoglycemia, lactic acidosis, hepatomegaly, hyperuricemia, hypertriglyceridemia."
  },
  "mpc": {
   "name": "Mitochondrial pyruvate carrier",
   "short": "",
   "aliases": [
    "MPC",
    "MPC1",
    "MPC2",
    "pyruvate carrier",
    "pyruvate transporter",
    "mitochondrial pyruvate transporter"
   ],
   "notes": "Carries pyruvate (with a proton) across the inner mitochondrial membrane into the matrix."
  },
  "mdh_m": {
   "name": "Malate dehydrogenase (mitochondrial)",
   "short": "",
   "aliases": [
    "malate dehydrogenase",
    "MDH",
    "mitochondrial malate dehydrogenase",
    "MDH2"
   ],
   "notes": "Oxaloacetate cannot cross the inner mitochondrial membrane, so it leaves as malate."
  },
  "maltrans": {
   "name": "Malate transporter",
   "short": "",
   "aliases": [
    "malate–α-ketoglutarate antiporter",
    "malate shuttle",
    "dicarboxylate carrier",
    "malate carrier",
    "SLC25A11"
   ],
   "notes": "Malate crosses the inner mitochondrial membrane on a carrier (the malate–α-ketoglutarate antiporter or the dicarboxylate carrier), carrying reducing equivalents with it."
  },
  "mdh_c": {
   "name": "Malate dehydrogenase (cytosolic)",
   "short": "",
   "aliases": [
    "malate dehydrogenase",
    "MDH",
    "cytosolic malate dehydrogenase",
    "MDH1"
   ],
   "notes": "Turns malate back into oxaloacetate in the cytosol, regenerating the NADH that gluconeogenesis needs (at the glyceraldehyde-3-phosphate dehydrogenase step)."
  },
  "g6pt": {
   "name": "Glucose-6-phosphate translocase",
   "short": "",
   "aliases": [
    "G6PT",
    "G6P translocase",
    "SLC37A4",
    "glucose-6-phosphate transporter",
    "G6P transporter"
   ],
   "notes": "Carries glucose-6-phosphate from the cytosol into the ER lumen, where glucose-6-phosphatase works. Deficiency: von Gierke disease type Ib (also neutropenia and infections)."
  },
  "glut2": {
   "name": "GLUT2",
   "short": "",
   "aliases": [
    "GLUT-2",
    "SLC2A2",
    "glucose transporter 2"
   ],
   "notes": "Glucose leaves the ER (that carrier is not established) and then the cell through GLUT2 into the blood. GLUT2 is bidirectional and high-capacity (liver, kidney, small intestine, β cells). Fanconi-Bickel syndrome: GLUT2 deficiency."
  }
 },
