    "aldolase B",
    "fructose-bisphosphate aldolase"
   ],
   "notes": "Joins DHAP + G3P into fructose-1,6-bisphosphate."
  },
  "fbp1": {
   "name": "Fructose-1,6-bisphosphatase",
   "short": "F-1,6-BPase",
