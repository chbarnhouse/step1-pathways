   ],
   "nicknames": [
    "FBPase",
    "FBPase-1"
   ],
   "notes": "Rate-limiting. Inhibited by AMP and fructose-2,6-bisphosphate; activated by citrate. Bypass of PFK-1."
  },
  "pgi": {
