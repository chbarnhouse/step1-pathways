 "enzymes": {
  "pc": {
   "name": "Pyruvate carboxylase",
   "short": "PC",
   "aliases": [],
   "notes": "Mitochondrial; needs biotin. Activated by acetyl-CoA (fatty acid oxidation signals 'make glucose'). First bypass of pyruvate kinase."
  },
  "pepck": {
   "name": "PEP carboxykinase",
   "short": "PEPCK",
   "aliases": [
    "phosphoenolpyruvate carboxykinase"
   ],
   "notes": "Uses GTP. Induced by glucagon and cortisol. Second half of the pyruvate kinase bypass."
  },
  "enolase": {
   "name": "Enolase",
   "short": "",
   "aliases": [],
   "notes": "Shared with glycolysis; runs in reverse here."
  },
  "pgm": {
   "name": "Phosphoglycerate mutase",
   "short": "PGM",
   "aliases": [
    "PGAM"
   ],
   "notes": "Shared with glycolysis."
  },
  "pgk": {
   "name": "Phosphoglycerate kinase",
   "short": "PGK",
   "aliases": [],
   "notes": "Shared with glycolysis; consumes ATP in this direction."
  },
  "gapdh": {
   "name": "Glyceraldehyde-3-phosphate dehydrogenase",
   "short": "GAPDH",
   "aliases": [
    "G3PDH"
   ],
   "notes": "Shared with glycolysis; consumes NADH in this direction."
  },
  "tpi": {
   "name": "Triose phosphate isomerase",
   "short": "TPI",
   "aliases": [
    "triosephosphate isomerase",
    "TIM"
   ],
   "notes": "Makes the DHAP that aldolase joins to G3P."
  },
  "aldolase": {
   "name": "Aldolase",
   "short": "",
   "aliases": [
    "aldolase A",
    "aldolase B",
    "fructose-bisphosphate aldolase"
   ],
   "notes": "Joins DHAP + G3P into fructose-1,6-bisphosphate."
  },
  "fbp1": {
   "name": "Fructose-1,6-bisphosphatase",
   "short": "F-1,6-BPase",
   "aliases": [
    "fructose 1,6-bisphosphatase",
    "FBPase",
    "FBPase-1",
    "fructose bisphosphatase"
   ],
   "notes": "Rate-limiting. Inhibited by AMP and fructose-2,6-bisphosphate; activated by citrate. Bypass of PFK-1."
  },
  "pgi": {
   "name": "Phosphoglucose isomerase",
   "short": "PGI",
   "aliases": [
    "glucose-6-phosphate isomerase",
    "GPI",
    "phosphohexose isomerase"
   ],
   "notes": "Shared with glycolysis."
  },
  "g6pase": {
   "name": "Glucose-6-phosphatase",
   "short": "G6Pase",
   "aliases": [
    "glucose 6-phosphatase"
   ],
   "notes": "In the ER lumen of liver and kidney (not muscle). Deficiency = von Gierke disease (type I glycogen storage): severe fasting hypoglycemia, lactic acidosis, hepatomegaly, hyperuricemia, hypertriglyceridemia."
  }
 },
