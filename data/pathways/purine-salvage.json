  "xo": {
   "name": "Xanthine oxidase",
   "short": "XO",
   "aliases": [
    "xanthine oxidoreductase",
    "xanthine dehydrogenase"
   ],
   "notes": "Inhibited by allopurinol and febuxostat (gout, tumor lysis prophylaxis). Also inactivates 6-mercaptopurine and azathioprine: reduce their doses with allopurinol. Rasburicase (recombinant uricase) instead converts uric acid to allantoin."
  },
  "gda": {
   "name": "Guanine deaminase",
   "short": "",
   "aliases": [
    "guanase"
   ]
  },
  "hgprt": {
   "name": "Hypoxanthine-guanine phosphoribosyltransferase",
   "short": "HGPRT",
   "aliases": [
    "HPRT",
    "hypoxanthine phosphoribosyltransferase"
   ],
   "notes": "Lesch-Nyhan syndrome (X-linked recessive): no HGPRT → purines can't be salvaged, so de novo synthesis ↑ and uric acid ↑. HGPRT: Hyperuricemia, Gout, Pissed off (aggression, self-mutilation), intellectual disability (Retardation), dysTonia. Treat with allopurinol or febuxostat (doesn't fix the neurologic signs)."
  },
  "aprt": {
   "name": "Adenine phosphoribosyltransferase",
   "short": "APRT",
   "aliases": [],
   "notes": "Deficiency → 2,8-dihydroxyadenine kidney stones."
  }
