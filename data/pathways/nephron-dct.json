 "enzymes": {
  "ncc": {
   "name": "NCC (Na⁺–Cl⁻ cotransporter)",
   "short": "",
   "aliases": [
    "NCC",
    "Na-Cl cotransporter",
    "Na+/Cl- cotransporter",
    "thiazide-sensitive cotransporter",
    "SLC12A3",
    "NCCT"
   ],
   "notes": "Carries Na⁺ with Cl⁻ into the cell (about 5% of filtered Na⁺). Thiazides block it (hydrochlorothiazide, chlorthalidone, metolazone): Na⁺ loss, and more Ca²⁺ reabsorbed (“thiazides take calcium in”; used for calcium stones). Gitelman syndrome: loss of NCC (hypokalemia, hypomagnesemia, low urine calcium)."
  },
  "nak": {
   "name": "Na⁺/K⁺-ATPase",
   "short": "",
   "aliases": [
    "Na/K ATPase",
    "Na+/K+ ATPase",
    "sodium-potassium pump",
    "Na pump",
    "Na-K-ATPase"
   ],
   "notes": "On the basolateral side of every tubular cell: 3 Na⁺ out, 2 K⁺ in, using ATP. Keeping cell Na⁺ low is what drives every apical Na⁺ carrier (secondary active transport)."
  },
  "clckb": {
   "name": "ClC-Kb (chloride channel)",
   "short": "",
   "aliases": [
    "ClC-Kb",
    "CLCNKB",
    "chloride channel",
    "barttin",
    "ClC-K"
   ],
   "notes": "Basolateral Cl⁻ channel that needs its partner barttin to work. Loss of either: Bartter syndrome (types 3 and 4)."
  },
  "trpv5": {
   "name": "TRPV5 (Ca²⁺ channel)",
   "short": "",
   "aliases": [
    "TRPV5",
    "epithelial calcium channel",
    "ECaC",
    "calcium channel"
   ],
   "notes": "Apical Ca²⁺ channel. PTH (and calcitriol) increase Ca²⁺ reabsorption here by adding TRPV5 and its partners."
  },
  "ncx1": {
   "name": "NCX1 (Na⁺/Ca²⁺ exchanger)",
   "short": "",
   "aliases": [
    "NCX1",
    "Na+/Ca2+ exchanger",
    "sodium-calcium exchanger",
    "SLC8A1",
    "PMCA",
    "Ca2+-ATPase"
   ],
   "notes": "Basolateral: 3 Na⁺ in for 1 Ca²⁺ out (with the Ca²⁺-ATPase PMCA). When thiazides lower cell Na⁺, this exit speeds up, one reason they raise Ca²⁺ reabsorption."
  },
  "trpm6": {
   "name": "TRPM6 (Mg²⁺ channel)",
   "short": "",
   "aliases": [
    "TRPM6",
    "magnesium channel"
   ],
   "notes": "Apical Mg²⁺ channel; its mutations cause hypomagnesemia with secondary hypocalcemia."
  },
  "mgout": {
   "name": "Basolateral Mg²⁺ exit (carrier not established)",
   "short": "",
   "aliases": [
    "basolateral magnesium transporter",
    "CNNM2",
    "magnesium exit"
   ],
   "notes": "How Mg²⁺ leaves the cell is not settled (CNNM2 is a candidate)."
  }
 },
