  },
  "adsl": {
   "name": "Adenylosuccinate lyase",
   "short": "ADSL",
   "aliases": [
    "adenylosuccinase"
   ],
   "notes": "Acts twice in purine synthesis (SAICAR → AICAR and adenylosuccinate → AMP), each time releasing fumarate — aspartate's nitrogen stays, its carbons leave."
  },
  "aicart": {
   "name": "AICAR transformylase",
   "short": "AICART",
   "aliases": [
    "aminoimidazole carboxamide ribonucleotide transformylase",
    "phosphoribosylaminoimidazolecarboxamide formyltransferase"
   ],
   "notes": "Second folate-dependent step (C2 from N¹⁰-formyl-THF). Methotrexate polyglutamates inhibit it."
  },
  "impch": {
   "name": "IMP cyclohydrolase",
   "short": "",
   "aliases": [
    "inosine monophosphate cyclohydrolase"
   ],
   "notes": "Closes the six-membered ring to give IMP; bifunctional with AICAR transformylase (ATIC)."
  },
  "adss": {
   "name": "Adenylosuccinate synthetase",
   "short": "ADSS",
   "aliases": [
    "adenylosuccinate synthase"
   ],
   "notes": "Uses GTP — so GMP supply promotes AMP synthesis. Inhibited by AMP."
  },
  "impdh": {
   "name": "IMP dehydrogenase",
   "short": "IMPDH",
   "aliases": [
    "inosine monophosphate dehydrogenase",
    "inosine-5′-monophosphate dehydrogenase"
   ],
   "notes": "Rate-limiting for GMP. Inhibited by mycophenolate (lymphocytes depend on de novo synthesis) and ribavirin; inhibited by GMP."
  },
