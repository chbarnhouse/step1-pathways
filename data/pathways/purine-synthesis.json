 "enzymes": {
  "prps": {
   "name": "PRPP synthetase",
   "short": "PRPS",
   "aliases": [
    "ribose-phosphate pyrophosphokinase",
    "phosphoribosyl pyrophosphate synthetase",
    "ribose-phosphate diphosphokinase"
   ],
   "notes": "Transfers pyrophosphate from ATP (ATP → AMP). Overactive PRPP synthetase (X-linked) causes uric acid overproduction and gout."
  },
  "ppat": {
   "name": "Glutamine-PRPP amidotransferase",
   "short": "GPAT",
   "aliases": [
    "amidophosphoribosyltransferase",
    "PRPP amidotransferase",
    "glutamine phosphoribosylpyrophosphate amidotransferase",
    "glutamine PRPP amidotransferase"
   ],
   "notes": "Rate-limiting, committed step. Inhibited by AMP, GMP and IMP; activated by PRPP. 6-Mercaptopurine (and azathioprine, its prodrug) inhibits it — 6-MP is activated by HGPRT and degraded by xanthine oxidase and TPMT, so allopurinol raises 6-MP toxicity."
  },
  "gars": {
   "name": "GAR synthetase",
   "short": "GARS",
   "aliases": [
    "glycinamide ribonucleotide synthetase",
    "phosphoribosylamine-glycine ligase"
   ],
   "notes": "Adds the whole glycine molecule (C4, C5, N7)."
  },
  "gart": {
