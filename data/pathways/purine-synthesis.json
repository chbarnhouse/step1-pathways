   "name": "GMP synthetase",
   "short": "GMPS",
   "aliases": [
    "GMP synthase",
    "guanosine monophosphate synthetase"
   ],
   "notes": "Uses ATP — so AMP supply promotes GMP synthesis. Glutamine donates the amino group."
  }
 },
