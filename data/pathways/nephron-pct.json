 "enzymes": {
  "nhe3": {
   "name": "NHE3 (Na⁺/H⁺ exchanger)",
   "short": "",
   "aliases": [
    "NHE3",
    "Na+/H+ exchanger",
    "sodium-hydrogen exchanger",
    "Na/H exchanger",
    "NHE",
    "SLC9A3",
    "Na⁺/H⁺ antiporter"
   ],
   "notes": "On the brush border: Na⁺ in, H⁺ (or NH₄⁺) out. The main way the PCT takes up Na⁺. Angiotensin II stimulates it, so more Na⁺, water and HCO₃⁻ are reabsorbed (contraction alkalosis)."
  },
  "nak": {
   "name": "Na⁺/K⁺-ATPase",
   "short": "",
   "aliases": [
    "Na/K ATPase",
    "Na+/K+ ATPase",
    "sodium-potassium pump",
    "Na pump",
    "Na-K-ATPase"
   ],
   "notes": "On the basolateral side of every tubular cell: 3 Na⁺ out, 2 K⁺ in, using ATP. Keeping cell Na⁺ low is what drives every apical Na⁺ carrier (secondary active transport)."
  },
  "ca4": {
   "name": "Carbonic anhydrase IV",
   "short": "",
   "aliases": [
    "CA IV",
    "carbonic anhydrase",
    "CA4",
    "brush border carbonic anhydrase"
   ],
   "notes": "On the brush border: H⁺ + HCO₃⁻ → H₂CO₃ → CO₂ + H₂O, so filtered HCO₃⁻ can be reclaimed as CO₂. Acetazolamide blocks it: HCO₃⁻ stays in the urine (alkaline urine, metabolic acidosis)."
  },
  "diff": {
   "name": "Simple diffusion",
   "short": "",
   "aliases": [
    "diffusion",
    "simple diffusion",
    "passive diffusion"
   ],
   "notes": "CO₂ is lipid-soluble and crosses the membrane without a carrier."
  },
  "ca2": {
   "name": "Carbonic anhydrase II",
   "short": "",
   "aliases": [
    "CA II",
    "carbonic anhydrase",
    "CA2",
    "cytosolic carbonic anhydrase"
   ],
   "notes": "Inside the cell: CO₂ + H₂O → H₂CO₃ → H⁺ + HCO₃⁻. The H⁺ is secreted again by NHE3; the HCO₃⁻ goes to the blood. Acetazolamide blocks it too. CA II deficiency: renal tubular acidosis with osteopetrosis."
  },
  "nbce1": {
   "name": "NBCe1 (Na⁺–HCO₃⁻ cotransporter)",
   "short": "",
   "aliases": [
    "NBCe1",
    "NBC1",
    "Na+-HCO3- cotransporter",
    "sodium-bicarbonate cotransporter",
    "SLC4A4",
    "NBC"
   ],
   "notes": "Basolateral: carries 1 Na⁺ with 3 HCO₃⁻ into the blood. Mutations cause proximal (type 2) renal tubular acidosis, with eye findings."
  },
  "sglt2": {
   "name": "SGLT2 (Na⁺–glucose cotransporter)",
   "short": "",
   "aliases": [
    "SGLT2",
    "SGLT",
    "sodium-glucose cotransporter 2",
    "Na-glucose cotransporter",
    "SLC5A2"
   ],
   "notes": "Takes up about 90% of filtered glucose, with Na⁺ (SGLT1 takes the rest further along). Saturates around a plasma glucose of 200 mg/dL, so glucose spills into urine above that (diabetes; also pregnancy, as GFR rises). SGLT2 inhibitors (-gliflozins: empagliflozin, dapagliflozin) block it."
  },
  "glut2": {
   "name": "GLUT2",
   "short": "",
   "aliases": [
    "GLUT2",
    "glucose transporter 2",
    "SLC2A2"
   ],
   "notes": "Basolateral facilitated diffusion of glucose out to the blood."
  },
  "naaa": {
   "name": "Na⁺–amino acid cotransporters",
   "short": "",
   "aliases": [
    "amino acid transporters",
    "Na+-amino acid cotransporter",
    "sodium-coupled amino acid transporters",
    "B0AT1",
    "rBAT"
   ],
   "notes": "Several Na⁺-coupled carriers reclaim all filtered amino acids. Defects: Hartnup disease (B⁰AT1, neutral amino acids like tryptophan: pellagra-like rash) and cystinuria (cystine, ornithine, lysine, arginine: cystine stones)."
  },
  "aaout": {
   "name": "Basolateral amino acid transporters",
   "short": "",
   "aliases": [
    "amino acid transporters",
    "basolateral amino acid transporter"
   ],
   "notes": "Let amino acids out of the cell into the blood."
  },
  "napi": {
   "name": "NaPi-IIa (Na⁺–phosphate cotransporter)",
   "short": "",
   "aliases": [
    "NaPi-IIa",
    "NaPi2a",
    "Na+-phosphate cotransporter",
    "sodium-phosphate cotransporter",
    "SLC34A1",
    "NPT2a"
   ],
   "notes": "Reclaims most filtered phosphate. PTH and FGF23 pull it out of the membrane, so phosphate is lost in the urine (hypophosphatemia in hyperparathyroidism and FGF23-excess rickets)."
  },
  "piout": {
   "name": "Basolateral phosphate exit (carrier not established)",
   "short": "",
   "aliases": [
    "basolateral phosphate transporter",
    "phosphate exit",
    "XPR1"
   ],
   "notes": "How phosphate leaves the cell for the blood is not settled (XPR1 is a candidate)."
  },
  "snat3": {
   "name": "SNAT3 (glutamine transporter)",
   "short": "",
   "aliases": [
    "SNAT3",
    "SLC38A3",
    "glutamine transporter",
    "basolateral glutamine transporter"
   ],
   "notes": "Takes glutamine up from the blood for ammoniagenesis; there is more of it in metabolic acidosis."
  },
  "glnase": {
   "name": "Glutaminase (ammoniagenesis)",
   "short": "",
   "aliases": [
    "glutaminase",
    "ammoniagenesis",
    "phosphate-dependent glutaminase",
    "glutamate dehydrogenase"
   ],
   "notes": "Glutamine → glutamate → α-ketoglutarate, releasing 2 NH₄⁺ and making 2 new HCO₃⁻ (to the blood). Ammoniagenesis rises in acidosis and with hypokalemia; hyperkalemia suppresses it (type 4 RTA: low urine NH₄⁺)."
  },
  "aqp1": {
   "name": "Aquaporin-1",
   "short": "",
   "aliases": [
    "AQP1",
    "aquaporin 1",
    "aquaporin",
    "water channel"
   ],
   "notes": "Always open water channels on both membranes of the PCT (and thin descending limb): water follows solute, so the PCT reabsorbs isotonically. Not regulated by ADH."
  },
  "oat": {
   "name": "OAT1 and OAT3 (organic anion transporters)",
   "short": "",
   "aliases": [
    "OAT1",
    "OAT3",
    "OAT",
    "organic anion transporter",
    "SLC22A6",
    "SLC22A8"
   ],
   "notes": "Basolateral: take up PAH, penicillin, methotrexate, NSAIDs and most diuretics from the blood, which is how loop and thiazide diuretics reach their targets in the lumen. Probenecid blocks them (it raises penicillin levels)."
  },
  "mrp": {
   "name": "MRP2 and MRP4 (apical efflux pumps)",
   "short": "",
   "aliases": [
    "MRP2",
    "MRP4",
    "MRP",
    "apical efflux",
    "multidrug resistance-associated protein"
   ],
   "notes": "Push organic anions out into the lumen (secretion)."
  }
 },
