   "name": "Fructokinase",
   "short": "",
   "aliases": [
    "ketohexokinase",
    "KHK"
   ],
   "notes": "Deficiency = essential fructosuria: benign, fructose in blood and urine (reducing sugar on urine test, glucose dipstick negative)."
  },
  "aldob": {
   "name": "Aldolase B",
   "short": "",
   "aliases": [
    "aldolase",
    "fructose-1-phosphate aldolase"
   ],
   "notes": "Deficiency = hereditary fructose intolerance (AR): vomiting, hypoglycemia, jaundice, cirrhosis after fruit, juice or honey (sucrose) is introduced. Treat by removing fructose and sucrose."
  },
  "tk": {
   "name": "Triose kinase",
   "short": "",
   "aliases": [
    "triokinase",
    "glyceraldehyde kinase"
   ],
   "notes": "Phosphorylates glyceraldehyde so it can join glycolysis."
  },
