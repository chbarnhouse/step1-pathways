   "name": "Fructose-1-phosphate",
   "short": "F1P",
   "aliases": [],
   "notes": "Builds up in hereditary fructose intolerance and traps phosphate → ↓ Pi blocks glycogenolysis and gluconeogenesis → hypoglycemia."
  },
  "glyceraldehyde": {
   "name": "Glyceraldehyde",
   "short": "",
   "aliases": [
