 "enzymes": {
  "diff": {
   "name": "Simple diffusion",
   "short": "",
   "aliases": [
    "diffusion",
    "simple diffusion",
    "passive diffusion"
   ],
   "notes": "Lipid-soluble gases (CO₂, NH₃) cross membranes without a carrier."
  },
  "ca2": {
   "name": "Carbonic anhydrase II",
   "short": "",
   "aliases": [
    "CA II",
    "carbonic anhydrase",
    "CA2",
    "cytosolic carbonic anhydrase"
   ],
   "notes": "Inside the cell: CO₂ + H₂O → H₂CO₃ → H⁺ + HCO₃⁻. Acetazolamide blocks it. CA II deficiency: renal tubular acidosis with osteopetrosis."
  },
  "hatp": {
   "name": "H⁺-ATPase",
   "short": "",
   "aliases": [
    "H+-ATPase",
    "proton pump",
    "V-ATPase",
    "vacuolar H+-ATPase",
    "H+ ATPase"
   ],
   "notes": "Pumps H⁺ into the urine (aldosterone stimulates it). Distal (type 1) renal tubular acidosis: α-intercalated cells cannot acidify the urine: urine pH stays above 5.5, hypokalemia, calcium phosphate stones (amphotericin B, Sjögren syndrome, lupus, genetic V-ATPase or AE1 defects)."
  },
  "hk": {
   "name": "H⁺/K⁺-ATPase",
   "short": "",
   "aliases": [
    "H+/K+-ATPase",
    "H+/K+ ATPase",
    "proton-potassium pump",
    "colonic H/K ATPase"
   ],
   "notes": "Swaps H⁺ out for K⁺ in: reclaims K⁺ in K⁺ depletion (one reason hypokalemia goes with alkalosis)."
  },
  "ae1": {
   "name": "AE1 (Cl⁻/HCO₃⁻ exchanger)",
   "short": "",
   "aliases": [
    "AE1",
    "band 3",
    "SLC4A1",
    "Cl-/HCO3- exchanger",
    "anion exchanger 1"
   ],
   "notes": "Basolateral: new HCO₃⁻ out to the blood in exchange for Cl⁻ (the same protein as band 3 in red cells). Mutations cause distal RTA (sometimes with hereditary spherocytosis)."
  },
  "trap": {
   "name": "NH₃ trapping (NH₃ + H⁺ → NH₄⁺)",
   "short": "",
   "aliases": [
    "ammonia trapping",
    "diffusion trapping",
    "NH3 trapping",
    "ammonium buffer"
   ],
   "notes": "NH₃ made in the PCT diffuses into the lumen and takes up a secreted H⁺; NH₄⁺ cannot diffuse back, so it is trapped. The main way acid leaves; it rises in acidosis."
  },
  "titr": {
   "name": "Titratable acid (HPO₄²⁻ + H⁺ → H₂PO₄⁻)",
   "short": "",
   "aliases": [
    "titratable acid",
    "phosphate buffer",
    "HPO4 buffer"
   ],
   "notes": "Filtered phosphate buffers secreted H⁺; measured as titratable acid."
  }
 },
